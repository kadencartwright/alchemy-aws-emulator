{
  "name": "alchemy-aws-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "demo": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "reset": "tsx src/cli.ts",
    "cleanup": "node scripts/cleanup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/client-sqs": "3.1166.0",
    "@effect/platform-node": "4.1.4",
    "@smithy/node-http-handler": "4.14.2",
    "alchemy": "2.0.0-beta.86",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
